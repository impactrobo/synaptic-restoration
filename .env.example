# Supabase project settings -> API keys (new publishable/secret key system).
# The publishable key is safe in the client; RLS is what protects the data.
# The secret key belongs in Edge Function secrets only - never here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
